# Copy to .env (Bun loads it automatically). Values below are the defaults.
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://wallet:wallet@localhost:5432/wallet
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_LOCK_TIMEOUT_MS=2000
DB_STATEMENT_TIMEOUT_MS=15000
TX_MAX_RETRIES=5
TX_RETRY_BASE_MS=20

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_BOOTSTRAP=true
SQS_WAGER_QUEUE=wager-transactions.fifo
SQS_WAGER_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wallet-events.fifo
SQS_MAX_RECEIVE_COUNT=5
SQS_VISIBILITY_TIMEOUT_S=30
SQS_WAIT_TIME_S=10
SQS_RETRY_BASE_S=2
SQS_RETRY_MAX_S=60

CONSUMER_ENABLED=true
CONSUMER_NAME=wager-transactions-consumer
CONSUMER_CONCURRENCY=10
OUTBOX_ENABLED=true
OUTBOX_POLL_MS=250
OUTBOX_BATCH_SIZE=10
OUTBOX_RETRY_BASE_MS=1000
OUTBOX_RETRY_MAX_MS=60000
PENDING_WORKER_ENABLED=true
PENDING_POLL_MS=500
PENDING_BATCH_SIZE=20
PENDING_RETRY_BASE_MS=1000
PENDING_RETRY_MAX_MS=120000
PENDING_MAX_ATTEMPTS=8
PENDING_LEASE_MS=30000
METRICS_GAUGE_INTERVAL_MS=5000
SHUTDOWN_TIMEOUT_MS=15000
# Test-only crash points: crash_after_commit | crash_after_publish
FAULT_INJECTION=
